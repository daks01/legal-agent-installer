{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/DeepSeek-V4-Flash",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{{DEEPSEEK_KEY}}"
      },
      "models": {
        "DeepSeek-V4-Flash": {
          "id": "deepseek-chat"
        }
      }
    }
  },
  "mcp": {
    "ru-legal": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/ru-legal/mcps/ru-legal-aggregator", "ru-legal-mcp"],
      "environment": {
        "RU_LEGAL_PACKS_ROOT": "{{LEGAL_AGENT_HOME}}/ru-legal/packs"
      },
      "enabled": true
    },
    "office-docs": {
      "type": "local",
      "command": ["uvx", "office-docs-mcp", "serve"],
      "enabled": true
    },
    "sudrf-scraper": {
      "type": "local",
      "command": ["uvx", "sudrf-scraper-mcp"],
      "enabled": true
    }
  }
}
