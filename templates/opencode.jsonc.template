{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/DeepSeek-V4-Flash",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{{DEEPSEEK_KEY}}"
      },
      "models": {
        "DeepSeek-V4-Flash": {
          "id": "deepseek-chat"
        }
      }
    }
  },
  "mcp": {
    "ru-legal": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/ru-legal/mcps/ru-legal-aggregator", "ru-legal-mcp"],
      "environment": {
        "RU_LEGAL_PACKS_ROOT": "{{LEGAL_AGENT_HOME}}/ru-legal/packs"
      },
      "enabled": true
    },
    "pravo": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/ru-legal/mcps/pravo", "pravo-mcp"],
      "enabled": true
    },
    "kad": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/ru-legal/mcps/kad", "kad-mcp"],
      "enabled": true
    },
    "egrul": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/ru-legal/mcps/egrul", "egrul-mcp"],
      "environment": {
        "API_FNS_KEY": "{{API_FNS_KEY}}"
      },
      "enabled": true
    },
    "office-docs": {
      "type": "local",
      "command": ["uvx", "office-docs-mcp", "serve"],
      "enabled": true
    },
    "sudrf-scraper": {
      "type": "local",
      "command": ["uvx", "--from", "{{LEGAL_AGENT_HOME}}/sudrf-scraper-mcp", "sudrf-scraper-mcp"],
      "enabled": true
    }
  }
}
